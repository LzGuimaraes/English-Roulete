APP_DOMAIN=english.seudominio.com.br
TRAEFIK_NETWORK=traefik-public
# CIDR da rede Docker do Traefik, obtido com docker network inspect.
TRUSTED_PROXY_CIDR=172.20.0.0/16
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
POSTGRES_DB=englishroulette
POSTGRES_USER=englishroulette
# Use senha aleatoria hexadecimal (openssl rand -hex 32), sem ; ou quebras de linha.
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_HEXADECIMAL_ALEATORIA
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES
