@page "/multiplayer"
@page "/join/{Code}"
@using EnglishRoulette.Contracts
@using EnglishRoulette.Web.Components
@using EnglishRoulette.Contracts.Admin
@using EnglishRoulette.Web.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.SignalR
@implements IAsyncDisposable
@inject RoomClient Client
@inject AdventureClient Catalog
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject StoryLanguagePreference LanguagePreference
<div class="experience game-experience room-experience @(_room is not null && !Playing ? "in-lobby" : "") motion-@(CurrentTheme.Motion) @(Playing ? "in-adventure phase-" + _room!.Match!.Scene.Phase.ToLowerInvariant() : "") @(Playing && _room!.Match!.Scene.Visual is not null ? "has-scene-art" : "") @(ThemePalette.IsHorror(CurrentGenre) ? "horror-experience" : "")" style="@ThemePalette.Style(CurrentTheme)">
    @if (Playing) { <div class="scene-backdrop"><SceneArtwork Visual="_room!.Match!.Scene.Visual" Background="true" /></div> }
    <header class="site-header"><a class="brand" href="/"><span class="brand-mark">✦</span>english<span class="brand-light">roulette</span></a><div class="header-actions"><GameMenu Horror="@ThemePalette.IsHorror(CurrentGenre)" Narrating="@(_room?.Match?.Scene.Phase == "Narrating")" Language="@CurrentLanguage" /><a class="secondary room-solo" href="/">Solo ↗</a></div></header>
    <main class="rooms-main">@if (!Playing) { <div class="eyebrow">MULTIPLAYER · SUA EQUIPE, UM DESTINO</div> }
        @if (_loading) { <p role="status">Preparando o ponto de encontro…</p> }
        else
        {
            @if (_error is not null) { <div class="admin-error" role="alert">@_error <button class="text-button" disabled="@_busy" @onclick="ReconnectAsync">Tentar reconectar</button></div> }
            @if (_guest is null || _editProfile)
            {
                <section class="room-intro"><div><h1>Boas histórias ficam<br /><em>melhores em grupo.</em></h1><p>Escolha seu apelido e avatar para criar uma sala ou entrar com seus amigos.</p></div>
                    <form class="admin-card room-profile" @onsubmit="IdentifyAsync" @onsubmit:preventDefault>
                        <label>Seu apelido<input required minlength="3" maxlength="20" @bind="_nickname" autocomplete="nickname" /></label>
                        <div class="avatar-picker" role="group" aria-label="Seu avatar">@foreach (var avatar in Avatars) { <button type="button" class="@(_avatar == avatar ? "selected" : "")" aria-label="Avatar @avatar" aria-pressed="@(_avatar == avatar)" @onclick="() => _avatar = avatar">@avatar</button> }</div>
                        <button class="primary" disabled="@_busy" type="submit">Entrar no lobby →</button>
                    </form>
                </section>
            }
            else if (_room is null)
            {
                <h1>Olá, @_guest.Nickname <span>@_guest.Avatar</span></h1><p>Prepare o grupo. Você pode criar uma sala privada ou usar um convite.</p>
                <div class="room-entry"><section class="admin-card"><div class="eyebrow">SEU GRUPO, SUA SALA</div><h2>Crie o ponto de encontro.</h2><LanguageSelector Value="@CurrentLanguage" ValueChanged="ChangeLanguageAsync" Disabled="_busy" /><p class="catalog-note">Texto e áudio no idioma escolhido para todo o grupo.</p><label>Nível das histórias<select value="@(_difficulty ?? "")" @onchange="EntryDifficultyChanged" disabled="@_busy"><option value="">Todos os níveis</option>@foreach (var level in AvailableLevels) { <option value="@level">@level</option> }</select></label><label>Vagas<select @bind="_capacity">@for (var size = 2; size <= 8; size++) { <option value="@size">@size jogadores</option> }</select></label><button class="primary" disabled="@_busy" @onclick="CreateAsync">Criar sala →</button></section>
                    <form class="admin-card" @onsubmit="JoinAsync" @onsubmit:preventDefault><div class="eyebrow">JÁ TEM UM CONVITE?</div><h2>Chegue mais.</h2><label>Código da sala<input @bind="_code" required maxlength="8" minlength="8" autocapitalize="characters" /></label><button class="secondary" disabled="@_busy" type="submit">Entrar na sala →</button></form></div>
                <button class="text-button" @onclick="() => _editProfile = true">Trocar apelido ou avatar</button>
            }
            else if (Playing)
            {
                <div class="match-toolbar"><span class="room-live">@(_live ? "● Sala conectada" : "○ Atualizando sala") · Sala @_room.Code · Partida @_room.GameNumber · @LanguageName</span><button class="text-button danger" disabled="@_busy" @onclick="LeaveAsync">Sair da sala</button></div>
                <MultiplayerAdventure Room="_room" ReceivedAtUtc="_receivedAtUtc" Busy="_busy" OnCommand="CommandAsync" OnChat="ChatAsync" OnNext="NextAsync" OnMenu="BackToMenuAsync" />
            }
            else
            {
                <div class="room-heading"><div><h1>@(_room.GameNumber > 1 ? $"Vamos para a partida {_room.GameNumber}?" : "Seu grupo chegou.")</h1><p><span class="room-live">@(_live ? "● Sala conectada" : "○ Atualizando sala")</span> · @_room.Members.Count de @_room.Capacity jogadores · @LanguageName</p></div><button class="text-button danger" disabled="@_busy" @onclick="LeaveAsync">Sair da sala</button></div>
                @if (_room.StoryVersionId is null)
                {
                    <section class="room-start-bar" aria-label="Início da partida">
                        <div><strong>@(_room.GameNumber > 1 ? CanSpin ? "Pontos mantidos. Todos prontos!" : "Pontos mantidos. Confirmem “Estou pronto!”" : CanSpin ? "Todos prontos. Vamos começar!" : "Preparem o grupo para começar.")</strong><p>@(_room.HostId == _room.ViewerId ? "Mínimo de 2 pessoas conectadas e todos prontos. Você gira a roleta." : "Mínimo de 2 pessoas conectadas e todos prontos. O anfitrião gira.")</p></div>
                        <div class="room-start-actions"><button class="secondary room-ready @(ViewerReady ? "is-ready" : "")" disabled="@_busy" @onclick="ReadyAsync">@(ViewerReady ? "Ainda estou me preparando" : "Estou pronto! ✓")</button>
                            @if (_room.HostId == _room.ViewerId) { <button class="primary" disabled="@(_busy || !CanSpin)" @onclick="SpinAsync">Iniciar e girar a roleta ↗</button> }
                        </div>
                        @if (FilteredStories.Count == 0) { <small>Nenhuma história disponível neste idioma e nível.</small> }
                        @if (FilteredStories.Count == 0) { <button class="text-button" disabled="@_busy" @onclick="ReconnectAsync">Recarregar catálogo</button> }
                    </section>
                    <section class="admin-card room-settings" aria-label="Configurações da sala">
                        <div><h2>Configurações da sala</h2><p>@(_room.HostId == _room.ViewerId ? "Defina antes de girar a roleta. Todos verão as alterações." : "O anfitrião define estas opções antes da partida.")</p></div>
                        <label>Tempo por pergunta<select value="@_room.QuestionSeconds" @onchange="QuestionSecondsChangedAsync" disabled="@(_busy || _room.HostId != _room.ViewerId)">@foreach (var seconds in QuestionTimeOptions) { <option value="@seconds">@seconds segundos</option> }</select></label>
                        <label>Vagas<select value="@_room.Capacity" @onchange="CapacityChangedAsync" disabled="@(_busy || _room.HostId != _room.ViewerId)">@for (var size = 2; size <= 8; size++) { <option value="@size" disabled="@(size < _room.Members.Count)">@size jogadores</option> }</select></label>
                        <label>Idioma<select value="@_room.Language" @onchange="RoomLanguageChangedAsync" disabled="@(_busy || _room.HostId != _room.ViewerId)"><option value="en">Inglês</option><option value="pt-BR">Português</option></select></label>
                        <label>Nível<select value="@(_room.Difficulty ?? "")" @onchange="RoomDifficultyChangedAsync" disabled="@(_busy || _room.HostId != _room.ViewerId)"><option value="">Todos os níveis</option>@foreach (var level in AvailableLevels) { <option value="@level">@level</option> }</select></label>
                    </section>
                }
                <div class="room-grid"><div class="room-lobby-sidebar"><section class="admin-card room-invitation"><div class="eyebrow">CONVIDE OS AMIGOS</div><div class="room-invite-controls"><strong class="room-code">@_room.Code</strong><div class="room-share-actions"><button class="secondary" @onclick="CopyAsync">@(_copied ? "Link copiado" : "Copiar link")</button><a class="secondary room-whatsapp" href="@WhatsappUrl" target="_blank" rel="noopener noreferrer" aria-label="Enviar convite pelo WhatsApp">WhatsApp ↗</a><button class="secondary" @onclick="ShareAsync">Compartilhar</button></div></div><details class="room-invite-link"><summary>Ver link de convite</summary><label>Link do convite<input readonly value="@InviteUrl" /></label></details>@if (_copied) { <p class="room-copy-status" role="status">Link copiado.</p> }
                        <div class="room-members">@foreach (var member in _room.Members) { <div class="room-member"><span class="member-avatar">@member.Avatar</span><div><strong>@member.Nickname @(member.PlayerId == _room.ViewerId ? "(você)" : "")</strong><small class="member-status-detail">@(member.PlayerId == _room.HostId ? "Anfitrião · " : "")@(member.Connected ? "Conectado" : "Reconectando…")@(_room.GameNumber > 1 ? $" · {member.Score} pontos" : "")</small>@if (_room.GameNumber > 1) { <small class="member-status-compact">@if (member.PlayerId == _room.HostId) { <span class="member-host-compact">Anfitrião</span> }<span class="member-presence @(member.Connected ? "is-online" : "is-offline")" title="@(member.Connected ? "Conectado" : "Reconectando")"><svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="4" /></svg><span class="transcript-accessible">@(member.Connected ? "Conectado" : "Reconectando")</span></span> @member.Score pontos</small> }</div><span class="member-ready @(member.Ready ? "is-ready" : "")" aria-label="@(member.Ready ? "Pronto" : "Preparando")" title="@(member.Ready ? "Pronto" : "Preparando")"><svg class="member-ready-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" />@if (member.Ready) { <path d="m6 10 3 3 5-6" /> }</svg><span class="member-ready-text">@(member.Ready ? "Pronto ✓" : "Preparando")</span></span></div> }</div>
                    </section><div class="room-chat-panel"><RoomChat Room="_room" Busy="_busy" OnChat="ChatAsync" /></div></div><section class="admin-card room-roulette"><div class="eyebrow">NINGUÉM ESCOLHE O DESTINO</div>
                        <StoryWheel Genres="Genres" ResultGenre="@SelectedStory?.Genre" ResultKey="@_room.StoryVersionId?.ToString()" Spinning="WheelSpinning" ElapsedSeconds="SpinElapsed" />
                        @if (SelectedStory is { } selected && !WheelSpinning)
                        { <h2>@selected.Title</h2><p>@selected.Synopsis</p><p class="catalog-note">@(CurrentLanguage == "pt-BR" ? "Português" : selected.Difficulty) · @selected.Genre · Resultado compartilhado por toda a sala.</p> }
                        else if (_room.StoryVersionId is null)
                        {
                            <h2>Prontos para o inesperado?</h2><p>Confirme sua presença acima. A roleta escolhe o gênero e a história para todo o grupo.</p>
                        }
                        @if (Genres.Count == 1) { <p class="catalog-note">Catálogo em expansão: só há histórias de @Genres[0] no momento. Pode haver repetição.</p> }
                        <p class="catalog-note">A mesma história para todos: ouçam as cenas, respondam às perguntas e votem nos caminhos. O placar considera acertos e ordem de chegada.</p>
                    </section></div>
            }
        }
    </main>
</div>
@code {
    [Parameter] public string? Code { get; set; }
    private static readonly string[] Avatars = ["🦊", "🐼", "🐙", "🦄", "🤖", "🐸", "🐯", "🐨"];
    private readonly CancellationTokenSource _life = new();
    private GuestView? _guest;
    private RoomView? _room;
    private List<PublicStoryView> _stories = [];
    private HubConnection? _hub;
    private IJSObjectReference? _shareModule;
    private Task? _poll;
    private bool Playing => _room?.Match is { Scene.Phase: not "Roulette" };
    private string _nickname = "", _avatar = "🦊", _code = "";
    private int _capacity = 8;
    private string? _difficulty;
    private static readonly int[] QuestionTimeOptions = [10, 15, 20, 30, 45, 60];
    private bool _loading = true, _busy, _refreshing, _connectionError, _editProfile, _live, _copied;
    private string? _error;
    private string CurrentLanguage => _room?.Language ?? LanguagePreference.Value;
    private string LanguageName => StoryLanguagePreference.Name(CurrentLanguage);
    private string? _requestedCatalogLanguage;
    private StoryAppearance CurrentTheme => ThemePalette.IsHorror(CurrentGenre) ? ThemePalette.Horror : _room?.Match?.Scene.Appearance ?? ThemePalette.Arcade;
    private string? CurrentGenre => _room?.Match?.Scene.Genre ?? SelectedStory?.Genre;
    private PublicStoryView? SelectedStory => _stories.FirstOrDefault(story => story.Id == _room?.StoryVersionId);
    private IReadOnlyList<string> AvailableLevels => _stories.Select(story => story.Difficulty).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();
    private IReadOnlyList<PublicStoryView> FilteredStories => _room?.Difficulty is { } level ? _stories.Where(story => story.Difficulty == level).ToArray() : _stories;
    private IReadOnlyList<string> Genres => FilteredStories.Select(story => story.Genre.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    private bool CanSpin => FilteredStories.Count > 0 && _room is { Members.Count: >= 2 } room && room.Members.All(member => member.Ready && member.Connected);
    private DateTimeOffset _receivedAtUtc;
    private DateTimeOffset _nextHubAttempt;
    private double SpinElapsed => _room?.RouletteStartedAtUtc is { } start ? Math.Max(0, (_room.ServerNowUtc - start + (Clock.GetUtcNow() - _receivedAtUtc)).TotalSeconds) : 0;
    private bool WheelSpinning => _room?.RouletteStartedAtUtc is not null && SpinElapsed < 5;
    private bool ViewerReady => _room?.Members.SingleOrDefault(member => member.PlayerId == _room.ViewerId)?.Ready == true;
    private string InviteUrl => Navigation.ToAbsoluteUri("join/" + _room?.Code).ToString();
    private string WhatsappUrl => "https://wa.me/?text=" + Uri.EscapeDataString("Jogue English Roulette comigo: " + InviteUrl);
    protected override async Task OnInitializedAsync()
    {
        _code = Code ?? "";
        await Run(async () => { _guest = await Client.MeAsync(_life.Token);
            if (_guest is not null) { _nickname = _guest.Nickname; _avatar = _guest.Avatar; await RefreshAsync(); }
            await LoadCatalogAsync(); });
        _loading = false; _poll = PollAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return; }
        try { _shareModule = await JS.InvokeAsync<IJSObjectReference>("import", "./room-share.js"); }
        catch (JSException) { /* Copy and WhatsApp remain available. */ }
    }
    private async Task LoadCatalogAsync()
    {
        var language = CurrentLanguage;
        _stories = [];
        _requestedCatalogLanguage = language;
        var stories = await Catalog.CatalogAsync(_life.Token, language);
        if (language == CurrentLanguage) { _stories = stories; }
        if (_room is null && _difficulty is not null && !AvailableLevels.Contains(_difficulty)) { _difficulty = null; }
    }
    private void EntryDifficultyChanged(ChangeEventArgs args) => _difficulty = string.IsNullOrEmpty(args.Value?.ToString()) ? null : args.Value.ToString();
    private Task ChangeLanguageAsync(string language) => Run(async () =>
    {
        if (_room is not null) { return; }
        LanguagePreference.Value = language;
        await LoadCatalogAsync();
    });
    private async Task ReconnectAsync() => await Run(async () => { await RefreshAsync(); await LoadCatalogAsync(); });
    private async Task IdentifyAsync() => await Run(async () => { _guest = await Client.IdentifyAsync(_nickname, _avatar, _life.Token); _editProfile = false; await RefreshAsync(); });
    private async Task CreateAsync() => await Run(async () => { _room = await Client.CreateAsync(_capacity, _life.Token, CurrentLanguage, _difficulty); _copied = false; _receivedAtUtc = Clock.GetUtcNow(); await ConnectAsync(); });
    private async Task JoinAsync() => await Run(async () => { _room = await Client.JoinAsync(_code, _life.Token); LanguagePreference.Value = _room.Language; await LoadCatalogAsync(); _copied = false; _receivedAtUtc = Clock.GetUtcNow(); await ConnectAsync(); });
    private async Task ReadyAsync() => await Run(async () => { if (_room is { } room) { _room = await Client.ReadyAsync(room, !ViewerReady, _life.Token); } });
    private async Task QuestionSecondsChangedAsync(ChangeEventArgs args) => await Run(async () =>
    {
        if (_room is not { } room || !int.TryParse(args.Value?.ToString(), out var seconds)) { return; }
        await SaveSettingsAsync(room, seconds, room.Capacity, room.Language, room.Difficulty);
    });
    private async Task CapacityChangedAsync(ChangeEventArgs args) => await Run(async () =>
    {
        if (_room is not { } room || !int.TryParse(args.Value?.ToString(), out var capacity)) { return; }
        await SaveSettingsAsync(room, room.QuestionSeconds, capacity, room.Language, room.Difficulty);
    });
    private async Task RoomLanguageChangedAsync(ChangeEventArgs args) => await Run(async () =>
    {
        if (_room is not { } room || args.Value is not string language) { return; }
        await SaveSettingsAsync(room, room.QuestionSeconds, room.Capacity, language, null);
        await LoadCatalogAsync();
    });
    private async Task RoomDifficultyChangedAsync(ChangeEventArgs args) => await Run(async () =>
    {
        if (_room is not { } room) { return; }
        var difficulty = string.IsNullOrEmpty(args.Value?.ToString()) ? null : args.Value.ToString();
        await SaveSettingsAsync(room, room.QuestionSeconds, room.Capacity, room.Language, difficulty);
    });
    private async Task SaveSettingsAsync(RoomView room, int seconds, int capacity, string language, string? difficulty)
    {
        _room = await Client.SettingsAsync(room, seconds, capacity, language, _life.Token, difficulty);
        _receivedAtUtc = Clock.GetUtcNow();
        LanguagePreference.Value = _room.Language;
    }
    private async Task SpinAsync() => await Run(async () => { if (_room is { } room) { _room = await Client.SpinAsync(room, _life.Token); _receivedAtUtc = Clock.GetUtcNow(); } });
    private async Task NextAsync() => await Run(async () =>
    { if (_room is { } room) { _room = await Client.NextAsync(room, _life.Token); _receivedAtUtc = Clock.GetUtcNow(); } });
    private async Task BackToMenuAsync() => await Run(async () =>
    {
        if (_room is { } room) { await Client.LeaveAsync(room.Id, _life.Token); _room = null; }
        if (_hub is not null) { await _hub.DisposeAsync(); _hub = null; }
        _live = false;
        Navigation.NavigateTo("/");
    });
    private async Task CommandAsync(MatchCommandRequest command) => await Run(async () =>
    { if (_room is { } room) { _room = await Client.CommandAsync(room, command, _life.Token); _receivedAtUtc = Clock.GetUtcNow(); } });
    private async Task ChatAsync(ChatMessageRequest message) => await Run(async () =>
    { if (_room is { } room) { _room = await Client.ChatAsync(room, message, _life.Token); _receivedAtUtc = Clock.GetUtcNow(); } });
    private async Task LeaveAsync() => await Run(async () => { if (_room is { } room) { await Client.LeaveAsync(room.Id, _life.Token); _room = null; _live = false; if (_hub is not null) { await _hub.DisposeAsync(); _hub = null; } } });
    private async Task CopyAsync()
    { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteUrl); _copied = true; } catch (JSException) { _error = "Selecione e copie o link do convite acima."; } }
    private async Task ShareAsync()
    {
        try
        {
            _shareModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./room-share.js");
            _copied = await _shareModule.InvokeAsync<string>("shareInvite", InviteUrl) == "copied";
        }
        catch (JSException) { _error = "Não foi possível compartilhar. Use Copiar link ou WhatsApp."; }
    }
    private async Task RefreshAsync()
    {
        if (_guest is null) { return; }
        var previous = _room?.Id;
        var next = await Client.CurrentAsync(_life.Token);
        // A slow read must not overwrite a newer command result or a different room.
        if (_room?.Id != previous || (_room is { } current && next is not null &&
            (next.StateVersion < current.StateVersion || next.StateVersion == current.StateVersion && next.ServerNowUtc < current.ServerNowUtc))) { return; }
        _room = next; _receivedAtUtc = Clock.GetUtcNow();
        if (_room is not null) { LanguagePreference.Value = _room.Language; }
        if (_requestedCatalogLanguage != CurrentLanguage) { await LoadCatalogAsync(); }
        if (previous != _room?.Id && _hub is not null) { await _hub.DisposeAsync(); _hub = null; _live = false; }
        if (_room is not null && _hub is null) { await ConnectAsync(); }
    }
    private async Task RefreshSafelyAsync()
    {
        if (_refreshing || _busy) { return; }
        _refreshing = true;
        try
        {
            await RefreshAsync();
            _live = _hub?.State == HubConnectionState.Connected;
            if (_connectionError) { _error = null; _connectionError = false; }
        }
        catch (RoomApiException error) { _error = error.Message; _connectionError = true; _live = false; }
        catch (HttpRequestException) { _error = "A conexão caiu. Seu lugar será preservado por até 90 segundos."; _connectionError = true; _live = false; }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
        finally { _refreshing = false; }
    }
    private async Task ConnectAsync()
    {
        if (_room is null || _hub is not null || Clock.GetUtcNow() < _nextHubAttempt) { return; }
        var hub = new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("hubs/rooms")).WithAutomaticReconnect().Build();
        _hub = hub;
        hub.On<Guid, long>("RoomChanged", (id, _) => InvokeAsync(async () => { if (!_busy && _room?.Id == id) { await RefreshSafelyAsync(); StateHasChanged(); } }));
        hub.Reconnecting += _ => InvokeAsync(() => { _live = false; StateHasChanged(); });
        hub.Reconnected += async _ => { if (_room is { } room) { await hub.InvokeAsync("JoinRoom", room.Id, _life.Token); } await InvokeAsync(async () => { _live = true; await RefreshSafelyAsync(); StateHasChanged(); }); };
        hub.Closed += _ => InvokeAsync(() => { _live = false; StateHasChanged(); });
        using var connectTimeout = CancellationTokenSource.CreateLinkedTokenSource(_life.Token);
        connectTimeout.CancelAfter(TimeSpan.FromSeconds(5));
        try { await hub.StartAsync(connectTimeout.Token); await hub.InvokeAsync("JoinRoom", _room.Id, connectTimeout.Token); _live = true; }
        catch (Exception error) when (error is HttpRequestException or HubException or InvalidOperationException or OperationCanceledException)
        { _live = false; _nextHubAttempt = Clock.GetUtcNow().AddSeconds(30); await hub.DisposeAsync(); if (ReferenceEquals(_hub, hub)) { _hub = null; } }
    }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try { while (await timer.WaitForNextTickAsync(_life.Token)) { await InvokeAsync(async () => { if (!_busy && _guest is not null) { await RefreshSafelyAsync(); } StateHasChanged(); }); } }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
    }
    private async Task Run(Func<Task> action)
    {
        if (_busy) { return; } _busy = true; _error = null; _connectionError = false;
        try { await action(); }
        catch (RoomApiException error) { _error = error.Message; if (_guest is not null) { try { _room = await Client.CurrentAsync(_life.Token); _receivedAtUtc = Clock.GetUtcNow(); }
            catch (Exception recovery) when (recovery is HttpRequestException or RoomApiException or OperationCanceledException) { _live = false; } } }
        catch (AdventureApiException) { _error = "Não foi possível carregar o catálogo. Use ‘Tentar reconectar’ para buscar as histórias novamente."; }
        catch (HttpRequestException) { _error = "A conexão caiu. Seu lugar será preservado por até 90 segundos."; _connectionError = true; }
        catch (OperationCanceledException) when (_life.IsCancellationRequested) { }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        await _life.CancelAsync(); if (_hub is not null) { await _hub.DisposeAsync(); }
        if (_shareModule is not null) { await _shareModule.DisposeAsync(); }
        if (_poll is not null) { await _poll; } _life.Dispose();
    }
}
