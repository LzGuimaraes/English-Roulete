@using System.Globalization
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<StoryWheel> Logger

<section @ref="_stage" class="roulette-stage @(Spinning ? "is-spinning" : "")" aria-label="Roleta de histórias">
    <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
    <span class="wheel-spark spark-one" aria-hidden="true">✦</span><span class="wheel-spark spark-two" aria-hidden="true">✧</span>
    <div class="wheel-pointer" aria-hidden="true">▼</div>
    <div class="wheel-rim">
        <div @key="ResultKey" class="story-wheel @(ResultGenre is not null ? "has-result" : "idle-wheel")" style="@WheelStyle" aria-hidden="true">
            @for (var i = 0; i < Segments.Count; i++)
            {
                var angle = (i + .5) * 360 / Segments.Count;
                <span class="wheel-label" style="transform:translate(-50%,-50%) rotate(@(Number(angle))deg) translateY(-120px) rotate(-@(Number(angle))deg)">@Segments[i]</span>
            }
        </div>
        <div class="wheel-hub" aria-hidden="true"><span>✦</span><strong>STORY</strong><small>ROULETTE</small></div>
    </div>
    <div class="wheel-caption" role="status" aria-live="polite">
        <span class="section-label">@(Spinning ? "HISTÓRIA CONFIRMADA · ROLETA GIRANDO" : ResultGenre is not null ? "GÊNERO SORTEADO" : "GÊNEROS DISPONÍVEIS")</span>
        <strong>@(Spinning ? "A história já foi sorteada." : ResultGenre ?? (Genres.Count == 0 ? "Aguardando o catálogo" : "Inicie para descobrir sua história"))</strong>
    </div>
    @if (!Spinning && ResultGenre is null && Genres.Count > 0)
    {
        <ul class="wheel-legend" aria-label="Gêneros disponíveis">@foreach (var genre in Genres) { <li>@genre</li> }</ul>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<string> Genres { get; set; } = [];
    [Parameter] public string? ResultGenre { get; set; }
    [Parameter] public string? ResultKey { get; set; }
    [Parameter] public bool Spinning { get; set; }
    [Parameter] public double ElapsedSeconds { get; set; }
    [Parameter] public double DurationSeconds { get; set; } = 5;
    private ElementReference _stage;
    private IJSObjectReference? _module;
    private string? _shownKey;
    private string? _animationKey;
    private double _animationOffset;
    protected override void OnParametersSet()
    {
        if (ResultKey is null) { _shownKey = null; }
        if (_animationKey != ResultKey)
        { _animationKey = ResultKey; _animationOffset = ElapsedSeconds; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Spinning && ResultKey is not null && _shownKey != ResultKey)
        {
            _shownKey = ResultKey;
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./game-atmosphere.js");
                await _module.InvokeVoidAsync("showWheel", _stage);
            }
            catch (JSException error)
            { Logger.LogWarning(error, "A rolagem opcional da roleta falhou; a aventura continua disponível."); }
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null) { await _module.DisposeAsync(); }
    }
    private IReadOnlyList<string> Segments => Genres;
    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private string WheelStyle
    {
        get
        {
            string[] colors = ["#8854ef", "#cb467c", "#e7a548", "#318d98", "#4764cb", "#5f44b5"];
            var slices = Enumerable.Range(0, Segments.Count).Select(i => $"{colors[i % colors.Length]} {Number(i * 100d / Segments.Count)}% {Number((i + 1) * 100d / Segments.Count)}%");
            var winner = Math.Max(0, Segments.ToList().FindIndex(genre => string.Equals(genre, ResultGenre, StringComparison.OrdinalIgnoreCase)));
            var rotation = 1800 + 360 - (winner + .5) * 360 / Math.Max(1, Segments.Count);
            var background = Segments.Count == 0 ? "#423550" : $"conic-gradient({string.Join(',', slices)})";
            return $"background:{background};--wheel-stop:{Number(rotation)}deg;--spin-duration:{Number(DurationSeconds)}s;--spin-delay:-{Number(Math.Clamp(_animationOffset, 0, DurationSeconds))}s;";
        }
    }
}
