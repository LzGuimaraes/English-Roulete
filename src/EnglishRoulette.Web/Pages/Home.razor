@page "/"
@using EnglishRoulette.Contracts
@using EnglishRoulette.Web.Components
@using EnglishRoulette.Web.Services
@implements IAsyncDisposable
@inject AdventureClient Client

<PageTitle>English Roulette — uma história, seu caminho</PageTitle>
<header class="site-header">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">e.</span><span>english<span class="brand-light">roulette</span><small>STORIES THAT TAKE YOU FURTHER</small></span></a>
    <span class="preview-badge"><span></span> Prévia · Solo Adventure</span>
</header>
<main>
    @if (_error is not null)
    {
        <div class="error-banner" role="alert">@_error <button class="text-button" @onclick="RefreshAsync">Tentar reconectar</button></div>
    }
    @if (_loading) { <div class="loading-screen" role="status">Abrindo seu próximo capítulo…</div> }
    else if (_state is null)
    {
        <section class="welcome">
            <div class="welcome-copy">
                <div class="eyebrow"><span class="small-line"></span> APRENDA INGLÊS. VIVA UMA HISTÓRIA.</div>
                <h1>Uma história.<br />Seu próximo<br /><em>caminho.</em></h1>
                <p class="lead">Um caderno perdido. Uma cidade cheia de pistas.<br class="desktop-break" /> E você no centro da aventura.</p>
                <p class="intro">Leia em inglês, descubra o que aconteceu e escolha como a história termina. Um capítulo de cada vez.</p>
                <div class="story-meta"><span>A2 · Inglês básico</span><span>3 cenas</span><span>2 finais possíveis</span></div>
                <button class="primary start-button" disabled="@_busy" @onclick="CreateAsync">@(_busy ? "Preparando…" : "Começar minha aventura") <span aria-hidden="true">↗</span></button>
                <p class="hint">Sem cadastro. Só você e uma boa história.</p>
            </div>
            <NotebookArt />
        </section>
        <section class="how-it-works" aria-label="Como jogar">
            <div><span class="step-number">01</span><strong>Entre na história</strong><p>Acompanhe uma cena curta em inglês.</p></div>
            <div><span class="step-number">02</span><strong>Siga as pistas</strong><p>Responda com o que você compreendeu.</p></div>
            <div><span class="step-number">03</span><strong>Escolha seu caminho</strong><p>Descubra aonde sua curiosidade leva.</p></div>
        </section>
    }
    else
    {
        <section class="adventure-heading">
            <div><div class="eyebrow">YOUR SOLO ADVENTURE · A2</div><h1>@_state.Title</h1></div>
            <button class="text-button" disabled="@_busy" @onclick="CreateAsync">Recomeçar ↻</button>
        </section>
        <div class="game-grid">
            <article class="story-card">
                <div class="chapter-heading"><span class="section-label">CAPÍTULO @_state.SceneNumber DE 3</span><span class="phase-badge">@(_state.Phase == "QuestionOpen" ? $"{RemainingSeconds}s para responder" : PhaseLabel)</span></div>
                <div class="chapter-progress" aria-label="Cena @_state.SceneNumber de 3">@for (var i = 1; i <= 3; i++) { <span class="@(i <= _state.SceneNumber ? "done" : "")"></span> }</div>
                <h2>@_state.SceneTitle</h2>
                @if (_state.Phase == "Preloading")
                {
                    <div class="scene-ready"><span class="scene-icon" aria-hidden="true">✦</span><h3>Mais uma pista espera por você.</h3><p>Reserve um momento para ler. A pergunta aparece depois da janela de leitura.</p><button class="primary" disabled="@_busy" @onclick="StartAsync">Ler esta cena <span aria-hidden="true">→</span></button></div>
                }
                else if (_state.Phase == "StoryResult")
                {
                    <div class="ending"><span class="ending-icon" aria-hidden="true">✦</span><div class="section-label">THE END · OU UM NOVO COMEÇO</div><h2>Você encontrou Nora.<br />E uma nova história.</h2><p>Um pequeno gesto transformou a noite de Mia. Seu caminho terminou @(_state.SceneKey == "cafe" ? "com um chocolate quente à beira do rio." : "com uma história compartilhada na biblioteca.")</p><div class="ending-stats"><span>3 cenas exploradas</span><span>1 final descoberto</span></div><button class="primary" disabled="@_busy" @onclick="CreateAsync">Descobrir o outro caminho ↗</button></div>
                }
                else
                {
                    <p class="narration" lang="en">@_state.Narration</p>
                    @if (_state.Phase == "Narrating") { <div class="reading-note"><span class="pulse-dot"></span><span>Leia com calma. A pergunta aparece em <strong>@RemainingSeconds s</strong>.</span></div> }
                    <QuestionPanel State="_state" Busy="_busy" OnAnswer="AnswerAsync" OnContinue="ContinueAsync" />
                    @if (_state.Phase == "DecisionOpen")
                    {
                        <section class="decision"><div class="section-label">SUA HISTÓRIA, SUA ESCOLHA</div><h2>Onde vamos procurar Nora?</h2><p>Não existe resposta errada. Siga sua curiosidade.</p>@foreach (var choice in _state.Choices) { <button class="choice" disabled="@_busy" @onclick="() => ChooseAsync(choice.Key)">@choice.Label <span aria-hidden="true">→</span></button> }</section>
                    }
                }
            </article>
            <aside class="journey-card">
                <span class="section-label">SEU PEQUENO GRANDE PASSEIO</span>
                <div class="journey-stop"><span class="journey-dot active"></span><div><strong>A estação</strong><small>Um encontro inesperado</small></div></div>
                <div class="journey-stop"><span class="journey-dot @(_state.SceneNumber >= 2 ? "active" : "")"></span><div><strong>A livraria</strong><small>Uma pista, dois caminhos</small></div></div>
                <div class="journey-stop"><span class="journey-dot @(_state.SceneNumber >= 3 ? "active" : "")"></span><div><strong>@(_state.SceneKey == "library" ? "A biblioteca" : _state.SceneKey == "cafe" ? "O café" : "Seu próximo destino")</strong><small>O final que você escolheu</small></div></div>
                @if (_state.Phase == "QuestionOpen") { <div class="timer" role="timer" aria-label="Tempo restante"><strong>@RemainingSeconds<span>s</span></strong><small>para seguir esta pista</small></div> }
                else { <blockquote>“Every new word<br />opens a new door.”</blockquote> }
                <p class="journey-hint">Não precisa entender cada palavra. Procure o sentido da história.</p>
            </aside>
        </div>
    }
</main>
<footer><span>Uma pequena aventura. Um pouco mais de inglês.</span><span>Prévia de leitura · áudio em breve</span></footer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private AdventureView? _state;
    private Task? _pollTask;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private long _generation;
    private DateTimeOffset _receivedAtUtc;

    private int RemainingSeconds => _state?.PhaseDeadlineUtc is { } deadline
        ? Math.Max(0, (int)Math.Ceiling((deadline - _state.ServerNowUtc - (DateTimeOffset.UtcNow - _receivedAtUtc)).TotalSeconds)) : 0;
    private string PhaseLabel => _state?.Phase switch
    {
        "Preloading" => "Uma nova cena", "Narrating" => "Hora da leitura", "QuestionOpen" => "Siga a pista",
        "QuestionReveal" => "Uma descoberta", "DecisionOpen" => "Escolha seu caminho", _ => "História concluída"
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _loading = false;
        _pollTask = PollAsync();
    }

    private void SetState(AdventureView? state)
    {
        _state = state;
        _receivedAtUtc = DateTimeOffset.UtcNow;
    }

    private async Task RefreshAsync()
    {
        var generation = _generation;
        try
        {
            var state = await Client.GetAsync(_lifetime.Token);
            if (generation == _generation && !_busy) { SetState(state); _error = null; }
        }
        catch (HttpRequestException) { _error = "Não foi possível conectar à aventura. Tente novamente."; }
    }

    private async Task CreateAsync() => await PerformAsync(() => Client.CreateAsync(_lifetime.Token));
    private async Task StartAsync() => await SendAsync("start");
    private async Task AnswerAsync(string option) => await SendAsync("answer", option: option);
    private async Task ContinueAsync() => await SendAsync("continue");
    private async Task ChooseAsync(string choice) => await SendAsync("choose", choice: choice);

    private async Task SendAsync(string kind, string? option = null, string? choice = null)
    {
        if (_state is not { } state) { return; }
        var command = new AdventureCommand(Guid.NewGuid(), state.StateVersion, kind, state.Question?.InstanceId, option, choice);
        await PerformAsync(() => Client.SendAsync(command, _lifetime.Token));
    }

    private async Task PerformAsync(Func<Task<AdventureView?>> action)
    {
        if (_busy) { return; }
        _busy = true;
        _generation++;
        try { SetState(await action()); _error = null; }
        catch (HttpRequestException) { _error = "A conexão foi interrompida. Reconecte para conferir sua aventura."; }
        finally { _busy = false; }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_busy && _state?.Phase is "Narrating" or "QuestionOpen") { await RefreshAsync(); }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_pollTask is not null) { await _pollTask; }
        _lifetime.Dispose();
    }
}
