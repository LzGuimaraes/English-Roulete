@using EnglishRoulette.Contracts
@inject TimeProvider Clock
<section class="adventure-heading"><div><div class="eyebrow">STORY BATTLE · @State.Genre · @(State.Language == "pt-BR" ? "Português" : "Inglês")</div><h1 lang="@State.Language">@State.Title</h1></div><span class="phase-badge">@PhaseLabel</span></section>
<div class="game-grid match-grid @(State.Phase == "StoryResult" ? "match-final-grid" : "")">
    <article class="story-card">
        <div class="chapter-heading"><span class="section-label">CENA @State.SceneNumber · JUNTOS NO MESMO CAMINHO</span>@if (State.Phase is "QuestionOpen" or "DecisionOpen") { <GameCountdown Seconds="@(Remaining ?? 0)" Label="@(State.Phase == "QuestionOpen" ? "Para responder" : "Para votar")" /> }</div>
        <h2 lang="@State.Language" @ref="_sceneHeading" tabindex="-1">@State.SceneTitle</h2>
        @if (State.Phase == "Cancelled")
        { <div class="error-banner" role="alert"><h3>Partida encerrada</h3><p>@Match.CancellationReason</p><p>Saia da sala para preparar uma nova partida com seus amigos.</p></div> }
        else if (State.Phase == "StoryResult")
        {
            <section class="match-finale">
                <h2 @ref="_endingHeading" tabindex="-1">História concluída!</h2>
                <MatchPodium Match="Match" ViewerId="Room.ViewerId" />
                <div class="match-final-actions">
                    @if (Room.HostId == Room.ViewerId)
                    { <button class="primary" disabled="@Busy" @onclick="() => OnNext.InvokeAsync()">Jogar outra história <span aria-hidden="true">→</span></button> }
                    else
                    { <p role="status">@Room.Members.Single(member => member.PlayerId == Room.HostId).Nickname pode preparar a próxima história. Seus pontos continuam nesta sala.</p> }
                    <button class="secondary" disabled="@Busy" @onclick="() => OnMenu.InvokeAsync()">Sair e voltar ao menu</button>
                </div>
                <p class="next-match-note">Na próxima partida, todos confirmam que estão prontos e a roleta sorteia outra história. Ao sair, você deixa esta sala.</p>
                <details class="scene-review final-story-review"><summary>Rever o desfecho · @State.SceneTitle</summary><div class="scene-review-content"><p lang="@State.Language" class="narration">@State.Narration</p>@if (State.Audio is { } finalAudio) { <audio class="ending-audio" src="@finalAudio.Url" controls preload="metadata" aria-label="@(State.Language == "pt-BR" ? "Narração do desfecho em português" : "Narração do desfecho em inglês")"></audio> }</div></details>
            </section>
        }
        else
        {
            @if (State.Audio is { } audio)
            {
                <NarrationPlayer @key="Match.SceneInstanceId" @ref="_narrator" Audio="audio" AudioElementId="@_audioId" Phase="@State.Phase" Synchronized="true" Language="@State.Language"
                    ServerNowUtc="PresentationNow" PhaseDeadlineUtc="State.PhaseDeadlineUtc" OnReady="ready => _audioReady = ready" />
            }
            @if (State.Phase == "Preloading")
            {
                <div class="scene-ready"><p>Carregue e ative o áudio. A contagem começa quando os jogadores conectados confirmarem.</p>
                    <button class="primary" disabled="@(Busy || !_audioReady || Match.MyAudioReady)" @onclick="ConfirmAsync">@(Match.MyAudioReady ? "Áudio confirmado ✓" : "Ativar áudio e confirmar")</button>
                    <p role="status">@(!_audioReady ? "Aguardando a narração carregar. Se falhar, tente carregar o áudio novamente." : Match.MyAudioReady ? "Aguardando os outros jogadores confirmarem o áudio." : "Toque para permitir a reprodução da narração.")</p>
                </div>
            }
            else if (State.Phase == "Countdown")
            { <div class="match-countdown"><p>Prepare os ouvidos.</p><GameCountdown Seconds="@(Remaining ?? 0)" Label="Próxima cena em" Large="true" /></div> }
            else
            {
                <ProgressiveNarration @key="(Match.SceneInstanceId, nameof(ProgressiveNarration))" Text="@State.Narration" Dialogue="State.Dialogue" Phase="@State.Phase" AudioElementId="@_audioId"
                    Words="State.WordHints" Cost="State.HintCost" SceneInstanceId="State.SceneInstanceId" Busy="Busy" OnUseHint="UseHintAsync" Language="@State.Language" />
                @if (State.Phase == "Narrating") { <GameCountdown Seconds="@(Remaining ?? 0)" Label="Pergunta em" /> }
                <WordHints State="State" Busy="Busy" OnUse="UseHintAsync" />
                <QuestionPanel State="State" Busy="Busy" AnswerSubmitted="Match.MyAnswerAccepted" AcceptedOptionKey="Match.MyOptionKey" ShowContinue="false" FocusOnOpen="true" OnAnswer="AnswerAsync" />
                @if (State.Phase == "QuestionReveal")
                {
                    <div class="match-round-footer"><details class="round-recap"><summary>Resultado da pergunta · @Match.RoundResults.Count jogadores</summary><ul class="match-round-results" aria-label="Resultado da pergunta">@foreach (var result in Match.RoundResults) { <li>@Match.Players.Single(player => player.Id == result.PlayerId).Nickname: @(result.Correct ? "acertou" : "sem acerto") · +@result.Points pontos</li> }</ul></details><GameCountdown Seconds="@(Remaining ?? 0)" Label="Próxima etapa em" /></div>
                }
                @if (State.Phase == "DecisionOpen")
                {
                    <section class="decision"><div class="section-label">DECISÃO DO GRUPO</div><h2 @ref="_decisionHeading" tabindex="-1">Por onde vamos?</h2><p>Um voto por pessoa. Em empate ou sem votos, o servidor sorteia entre os caminhos mais votados.</p>
                        @foreach (var choice in State.Choices)
                        { <button class="choice @(Match.MyVoteKey == choice.Key ? "selected" : "")" disabled="@(Busy || Match.MyVoteAccepted)" @onclick="() => VoteAsync(choice.Key)">@choice.Label @(Match.MyVoteKey == choice.Key ? "✓" : "→")</button> }
                        @if (Match.MyVoteAccepted) { <p role="status">Voto registrado. Aguardando o grupo ou o fim do prazo.</p> }
                    </section>
                }
            }
        }
        @if (_audioError is not null) { <p class="error-banner" role="alert">@_audioError</p> }
    </article>
    @if (State.Phase != "StoryResult")
    {
    <aside class="match-scoreboard @(_showScoreboard ? "scoreboard-expanded" : "")"><div class="scoreboard-heading"><h2>@(State.Phase == "StoryResult" ? "Placar final" : "Seu grupo")</h2><button class="text-button scoreboard-toggle" aria-expanded="@_showScoreboard" aria-controls="shared-scoreboard" @onclick="() => _showScoreboard = !_showScoreboard">@(_showScoreboard ? "Fechar placar" : $"Ver {Match.Players.Count} jogadores")</button></div>
        <div id="shared-scoreboard" class="scoreboard-content">
        <ol>@foreach (var player in Match.Players.OrderByDescending(player => player.Score).ThenBy(player => player.Nickname))
        { <li class="@(player.Id == Room.ViewerId ? "is-viewer" : "")"><span class="member-avatar">@player.Avatar</span><div><strong>@player.Nickname @(Match.Winners.Contains(player.Id) ? "✦" : "")</strong><small>@PlayerStatus(player) · @player.CorrectAnswers @(player.CorrectAnswers == 1 ? "acerto" : "acertos")</small></div><b>@player.Score<small>pontos</small></b></li> }</ol>
        <details class="match-rules"><summary>Como funciona a pontuação</summary><div class="match-disclosure-content"><p>Acertos valem 200, 180, 160… pontos pela ordem de chegada. Respostas em até 300 ms empatam na mesma posição.</p></div></details>
        @if (Match.Players.Count(player => player.Connected && !player.Left) < 2 && State.Phase is not "StoryResult" and not "Cancelled")
        { <p role="status">Aguardando reconexão. Os prazos abertos continuam válidos; a próxima cena aguarda o grupo. A vaga é preservada por até 90 segundos.</p> }
        <details class="match-journey"><summary>Caminho do grupo · @State.SceneNumber @(State.SceneNumber == 1 ? "cena" : "cenas")</summary><div class="match-disclosure-content">@foreach (var scene in State.VisitedScenes ?? []) { <p>@scene.Title</p> }
            @if (Match.LastDecision is { } decision)
            { <p class="match-decision-note">Decisão em @decision.SceneTitle: @decision.Choice.@(decision.NoVotes ? " Sem votos: caminho sorteado no servidor." : decision.Tied ? " Empate: caminho sorteado entre os mais votados." : " Escolha da maioria.")</p> }
        </div></details>
        </div>
    </aside>
    }
</div>
@code {
    [Parameter, EditorRequired] public RoomView Room { get; set; } = default!;
    [Parameter] public DateTimeOffset ReceivedAtUtc { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
    [Parameter] public EventCallback<MatchCommandRequest> OnCommand { get; set; }
    private MultiplayerMatchView Match => Room.Match!;
    private AdventureView State => Match.Scene;
    private readonly string _audioId = "shared-narration-" + Guid.NewGuid().ToString("N");
    private NarrationPlayer? _narrator;
    private ElementReference _decisionHeading, _endingHeading, _sceneHeading;
    private string? _focusedPhase;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusedPhase == State.Phase) { return; }
        _focusedPhase = State.Phase;
        if (State.Phase == "Preloading") { await _sceneHeading.FocusAsync(); }
        if (State.Phase == "DecisionOpen") { await _decisionHeading.FocusAsync(); }
        if (State.Phase == "StoryResult") { await _endingHeading.FocusAsync(); }
    }
    private bool _audioReady;
    private bool _showScoreboard;
    private string? _audioError;
    private DateTimeOffset _receivedAt;
    private DateTimeOffset _snapshotAt;
    private Guid _instance;
    private DateTimeOffset PresentationNow => State.ServerNowUtc + (Clock.GetUtcNow() - _receivedAt);
    private int? Remaining => State.PhaseDeadlineUtc is { } deadline ? Math.Max(0, (int)Math.Ceiling((deadline - PresentationNow).TotalSeconds)) : null;
    private string PhaseLabel => State.Phase switch { "Preloading" => "Preparando áudio", "Countdown" => "Contagem regressiva", "Narrating" => "Ouça a cena", "QuestionOpen" => "Responda agora", "QuestionReveal" => "Resultado da pergunta", "DecisionOpen" => "Votação aberta", "StoryResult" => "Final alcançado", _ => "Partida encerrada" };
    protected override void OnParametersSet()
    {
        if (_snapshotAt != State.ServerNowUtc) { _snapshotAt = State.ServerNowUtc; _receivedAt = ReceivedAtUtc; }
        if (_instance != Match.SceneInstanceId) { _instance = Match.SceneInstanceId; _audioReady = false; _audioError = null; }
    }
    private string PlayerStatus(MatchPlayerView player) => player.Left ? "Saiu" : !player.Connected ? "Reconectando" : State.Phase switch
    { "Preloading" => player.AudioReady ? "Áudio pronto" : "Preparando", "QuestionOpen" => player.Answered ? "Respondeu" : "Respondendo", "DecisionOpen" => player.Voted ? "Votou" : "Votando", _ => "Conectado" };
    private async Task ConfirmAsync()
    {
        _audioError = null;
        try { if (_narrator is not null) { await _narrator.UnlockAsync(); await SendAsync("audio-ready"); } }
        catch (JSException) { _audioError = "O navegador não liberou o áudio. Toque novamente para ativar e confirmar."; }
    }
    private Task SendAsync(string kind, string? key = null) => OnCommand.InvokeAsync(new(Guid.NewGuid(), State.StateVersion, Match.SceneInstanceId, kind, key));
    private Task AnswerAsync(string key) => SendAsync("answer", key);
    private Task UseHintAsync(string key) => SendAsync("hint", key);
    private Task VoteAsync(string key) => SendAsync("vote", key);
}
