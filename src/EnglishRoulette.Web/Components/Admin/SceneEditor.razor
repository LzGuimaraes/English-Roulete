@using EnglishRoulette.Contracts.Admin
@using EnglishRoulette.Contracts
@using EnglishRoulette.Web.Components

<section class="admin-scene">
    <div class="admin-title"><h3>Cena @(Position + 1) · @(string.IsNullOrEmpty(Scene.Title) ? "Sem título" : Scene.Title)</h3><button type="button" class="text-button danger" disabled="@(ReadOnly || Busy)" @onclick="() => OnRemove.InvokeAsync()">Remover cena</button></div>
    <fieldset disabled="@(ReadOnly || Busy)">
        <div class="admin-form-grid"><label>Chave da cena<input @bind="Scene.Key" @bind:after="Changed" maxlength="80" placeholder="estacao" /></label><label>Título da cena<input @bind="Scene.Title" @bind:after="Changed" maxlength="200" /></label></div>
        <label>Texto da narração no idioma da história<textarea rows="5" @bind="Scene.Narration" @bind:after="Changed" maxlength="10000"></textarea></label>
        <label>Tradução completa da narração (liberada após a resposta)<textarea rows="4" @bind="Scene.FullTranslation" @bind:after="Changed" maxlength="10000" placeholder="Traduza toda a cena para apoiar o aprendizado."></textarea></label>
        <label>Descrição da imagem no idioma da história<input @bind="Scene.VisualDescription" @bind:after="Changed" maxlength="300" placeholder="Descreva os personagens e objetos visíveis." /></label>
        <details class="admin-support"><summary>Vocabulário e diálogos</summary>
            <p class="hint">Dicas traduzem termos das cenas inglesas ou explicam palavras das cenas portuguesas. O jogador vê o custo antes de usar.</p>
            @foreach (var hint in Scene.Vocabulary)
            {
                <div class="admin-form-grid" @key="hint.Key">
                    <label>Palavra ou expressão<input @bind="hint.Term" @bind:after="Changed" maxlength="80" /></label>
                    <label>Tradução ou significado em português<input @bind="hint.Translation" @bind:after="Changed" maxlength="300" /></label>
                    <button type="button" class="text-button danger" @onclick="() => RemoveHint(hint)">Remover dica</button>
                </div>
            }
            <button type="button" class="secondary" disabled="@(Scene.Vocabulary.Count >= 12)" @onclick="AddHint">Adicionar palavra</button>
            <h4>Falas no áudio</h4>
            <p class="hint">Divida todo o texto da narração em falas, na mesma ordem. Informe os intervalos reais da gravação em milissegundos. Os nomes identificam personagens; o áudio continua sendo o enviado abaixo.</p>
            @foreach (var cue in Scene.Dialogue)
            {
                <div class="admin-dialogue" @key="cue.Key">
                    <label>Personagem / narrador<input @bind="cue.Speaker" @bind:after="Changed" maxlength="60" /></label>
                    <label>Texto exato da fala<textarea rows="2" @bind="cue.Text" @bind:after="Changed" maxlength="3000"></textarea></label>
                    <div class="admin-form-grid"><label>Início (ms)<input type="number" min="0" @bind="cue.StartMilliseconds" @bind:after="Changed" /></label><label>Fim (ms)<input type="number" min="1" @bind="cue.EndMilliseconds" @bind:after="Changed" /></label></div>
                    <button type="button" class="text-button danger" @onclick="() => RemoveCue(cue)">Remover fala</button>
                </div>
            }
            <button type="button" class="secondary" disabled="@(Scene.Dialogue.Count >= 40)" @onclick="AddCue">Adicionar fala</button>
        </details>
        <label class="admin-check"><input type="checkbox" @bind="Scene.IsEnding" @bind:after="Changed" /> Esta cena é um final</label>
        <label>Pergunta no idioma da história<input @bind="Scene.Prompt" @bind:after="Changed" maxlength="1000" /></label>
        <div class="section-label">ALTERNATIVAS</div>
        @foreach (var option in Scene.Options)
        {
            <div class="admin-option"><span>@option.Key.ToUpperInvariant()</span><input aria-label="Alternativa @option.Key" @bind="option.Text" @bind:after="Changed" maxlength="1000" /><button type="button" class="text-button" @onclick="() => RemoveOption(option)">Remover</button></div>
        }
        <button type="button" class="secondary" disabled="@(Scene.Options.Count >= 8)" @onclick="AddOption">+ Alternativa</button>
        <label>Resposta correta<select @bind="Scene.CorrectOptionKey" @bind:after="Changed"><option value="">Escolha uma alternativa</option>@foreach (var option in Scene.Options) { <option value="@option.Key">@option.Key.ToUpperInvariant() · @option.Text</option> }</select></label>
        <label>Explicação da resposta<textarea rows="2" @bind="Scene.Explanation" @bind:after="Changed" maxlength="3000"></textarea></label>
        @if (!Scene.IsEnding)
        {
            <div class="section-label">PRÓXIMOS CAMINHOS</div>
            @foreach (var transition in Scene.Transitions)
            {
                <div class="admin-transition"><label>Chave<input @bind="transition.Key" @bind:after="Changed" /></label><label>Texto da escolha<input @bind="transition.Label" @bind:after="Changed" /></label><label>Destino<select @bind="transition.TargetSceneKey" @bind:after="Changed"><option value="">Escolha uma cena</option>@foreach (var target in AllScenes) { <option value="@target.Key">@target.Key · @target.Title</option> }</select></label><button type="button" class="text-button" @onclick="() => RemoveTransition(transition)">Remover</button></div>
            }
            <button type="button" class="secondary" disabled="@(Scene.Transitions.Count >= 8)" @onclick="AddTransition">+ Caminho</button>
        }
    </fieldset>
    <div class="admin-audio"><h4>Imagem ou animação da cena</h4>
        @if (Scene.Visual is { } visual)
        {
            <SceneArtwork Visual="@(new SceneVisualView(visual.PreviewUrl, visual.AltText, visual.Animated))" />
            @if (!ReadOnly) { <button class="text-button danger" disabled="@Busy" @onclick="RemoveVisual">Remover imagem desta cena</button> }
        }
        @if (!ReadOnly && CanUpload)
        {
            <label>Descrição acessível da imagem<input @bind="_altText" @bind:event="oninput" maxlength="300" /></label>
            <label>Créditos da imagem<input @bind="_visualAttribution" @bind:event="oninput" maxlength="2000" /></label><label>Licença da imagem<input @bind="_visualEvidence" @bind:event="oninput" maxlength="2000" /></label>
            <label>Enviar ou substituir imagem (PNG/APNG, JPEG, GIF até 8 MB)<InputFile OnChange="UploadVisual" accept="image/png,image/jpeg,image/gif" disabled="@(Busy || string.IsNullOrWhiteSpace(_altText) || string.IsNullOrWhiteSpace(_visualAttribution) || string.IsNullOrWhiteSpace(_visualEvidence))" /></label>
        }
        else if (!ReadOnly) { <p class="hint">Salve a cena antes de enviar a imagem ou animação.</p> }
    </div>
    <div class="admin-audio"><h4>Narração da cena</h4>
        @if (Scene.Audio is { } audio) { <p>@(audio.DurationMs / 1000d) segundos · @audio.Attribution</p><audio controls preload="metadata" src="@audio.PreviewUrl"></audio>@if (!ReadOnly) { <button class="text-button danger" disabled="@Busy" @onclick="RemoveAudio">Remover áudio desta cena</button> } }
        else { <p>Nenhum áudio enviado.</p> }
        @if (!ReadOnly)
        {
            @if (!CanUpload) { <p class="hint">Salve o rascunho e o texto da cena antes de enviar a narração.</p> }
            else
            {
                <label>Créditos do áudio<input @bind="_attribution" @bind:event="oninput" maxlength="2000" /></label><label>Licença / evidência de permissão<input @bind="_evidence" @bind:event="oninput" maxlength="2000" /></label>
                <label class="audio-upload">Enviar ou substituir WAV (PCM 16 bits, até 10 MB / 2 minutos)<InputFile OnChange="Upload" accept=".wav,audio/wav" disabled="@(Busy || string.IsNullOrWhiteSpace(_attribution) || string.IsNullOrWhiteSpace(_evidence))" /></label>
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public AdminSceneEditor Scene { get; set; } = new();
    [Parameter] public List<AdminSceneEditor> AllScenes { get; set; } = [];
    [Parameter] public int Position { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanUpload { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public EventCallback<VisualUpload> OnVisualUpload { get; set; }
    [Parameter] public EventCallback<SceneUpload> OnUpload { get; set; }
    private string _altText = "", _visualAttribution = "", _visualEvidence = "";
    private async Task RemoveAudio() { Scene.Audio = null; await Changed(); }
    private async Task RemoveVisual() { Scene.Visual = null; await Changed(); }
    private async Task UploadVisual(InputFileChangeEventArgs arguments) => await OnVisualUpload.InvokeAsync(new(Scene, arguments.File, _altText, _visualAttribution, _visualEvidence));
    public sealed record VisualUpload(AdminSceneEditor Scene, IBrowserFile File, string AltText, string Attribution, string Evidence);
    private string _attribution = "", _evidence = "";
    protected override void OnInitialized() { _altText = Scene.Visual?.AltText ?? ""; _visualAttribution = Scene.Visual?.Attribution ?? ""; _visualEvidence = Scene.Visual?.LicenseEvidence ?? ""; _attribution = Scene.Audio?.Attribution ?? ""; _evidence = Scene.Audio?.LicenseEvidence ?? ""; }
    private async Task Changed() => await OnChanged.InvokeAsync();
    private async Task AddHint() { Scene.Vocabulary.Add(new() { Key = "word-" + Guid.NewGuid().ToString("N")[..8] }); await Changed(); }
    private async Task RemoveHint(AdminVocabularyHint hint) { Scene.Vocabulary.Remove(hint); await Changed(); }
    private async Task AddCue() { Scene.Dialogue.Add(new() { Key = "cue-" + Guid.NewGuid().ToString("N")[..8], StartMilliseconds = Scene.Dialogue.LastOrDefault()?.EndMilliseconds ?? 0 }); await Changed(); }
    private async Task RemoveCue(AdminDialogueCue cue) { Scene.Dialogue.Remove(cue); await Changed(); }
    private async Task AddOption()
    {
        var key = Enumerable.Range(0, 8).Select(index => ((char)('a' + index)).ToString()).First(value => Scene.Options.All(option => option.Key != value));
        Scene.Options.Add(new() { Key = key }); await Changed();
    }
    private async Task RemoveOption(AdminOptionEditor option) { Scene.Options.Remove(option); await Changed(); }
    private async Task AddTransition() { Scene.Transitions.Add(new() { Key = "caminho-" + Guid.NewGuid().ToString("N")[..6] }); await Changed(); }
    private async Task RemoveTransition(AdminTransitionEditor transition) { Scene.Transitions.Remove(transition); await Changed(); }
    private async Task Upload(InputFileChangeEventArgs arguments) => await OnUpload.InvokeAsync(new(Scene, arguments.File, _attribution, _evidence));
    public sealed record SceneUpload(AdminSceneEditor Scene, IBrowserFile File, string Attribution, string Evidence);
}
