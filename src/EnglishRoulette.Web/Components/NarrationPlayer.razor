@using EnglishRoulette.Contracts
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject TimeProvider Clock

<section class="audio-player" aria-label="@NarrationLabel">
    <div class="audio-heading"><strong>@NarrationLabel</strong><span>Ouça a cena antes de responder</span></div>
    <audio id="@AudioElementId" @ref="_audio" @key="Audio.Url" src="@Audio.Url" preload="auto"
           controls="@(Phase == "Narrating" && !Synchronized)" @oncanplay="ReadyAsync" @onerror="FailedAsync"></audio>
    @if (_failed)
    {
        <p role="alert">Não foi possível carregar a narração.</p>
        <button class="text-button" @onclick="ReloadAsync">Tentar carregar áudio novamente</button>
    }
    else if (Phase == "Preloading")
    {
        <p>@(_ready ? "Áudio pronto. Confirme para iniciar." : "Carregando narração…")</p>
    }
    else if (Phase == "Narrating")
    {
        @if (Synchronized)
        {
            <p class="audio-timing-note">Áudio sincronizado com a sala.</p>
            <button class="text-button" @onclick="MuteAsync">@(_muted ? "Ativar som" : "Silenciar")</button>
            @if (_autoplayBlocked) { <button class="secondary" @onclick="ResumeAsync">Reproduzir narração sincronizada</button> }
        }
        else { <p class="audio-timing-note">Pausar o áudio não pausa o tempo da cena.</p> }
    }
</section>

@code {
    [Parameter] public string Language { get; set; } = "en";
    private string NarrationLabel => Language == "pt-BR" ? "Narração em português" : "Narração em inglês";
    [Parameter, EditorRequired] public AudioView Audio { get; set; } = default!;
    [Parameter] public string AudioElementId { get; set; } = "narration-" + Guid.NewGuid().ToString("N");
    [Parameter] public string Phase { get; set; } = "Preloading";
    [Parameter] public DateTimeOffset ServerNowUtc { get; set; }
    [Parameter] public DateTimeOffset? PhaseDeadlineUtc { get; set; }
    [Parameter] public EventCallback<bool> OnReady { get; set; }
    [Parameter] public bool Synchronized { get; set; }
    private bool _autoplayBlocked, _muted;
    private DateTimeOffset _snapshotTime, _receivedAt;
    protected override void OnParametersSet()
    {
        if (_snapshotTime != ServerNowUtc) { _snapshotTime = ServerNowUtc; _receivedAt = Clock.GetUtcNow(); }
    }
    private double Offset => PhaseDeadlineUtc is { } deadline
        ? (Audio.DurationMilliseconds + Audio.SafetyMarginMilliseconds) / 1000d -
          (deadline - (ServerNowUtc + (Clock.GetUtcNow() - _receivedAt))).TotalSeconds : 0;
    private ElementReference _audio;
    private IJSObjectReference? _module;
    private string? _lastUrl;
    private string? _lastPhase;
    private DateTimeOffset _lastAlignedAt;
    private bool _ready;
    private bool _failed;
    private bool _moduleFailed;
    private bool _reportedReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_moduleFailed) { return; }
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", "./audio-player.js");
            if (_lastUrl != Audio.Url || _lastPhase != Phase)
            {
                _lastUrl = Audio.Url;
                _lastPhase = Phase;
                if (Synchronized) { _autoplayBlocked = !await _module.InvokeAsync<bool>("synchronizeShared", _audio, Phase, Offset); }
                else { await _module.InvokeVoidAsync("synchronize", _audio, Phase, Offset); }
                StateHasChanged();
            }
            if (await _module.InvokeAsync<bool>("isReady", _audio)) { _ready = true; }
            if (Synchronized && Phase == "Narrating" && _ready && _lastAlignedAt != ServerNowUtc)
            {
                _lastAlignedAt = ServerNowUtc;
                await _module.InvokeVoidAsync("alignShared", _audio, Offset);
            }
            await ReportReadyAsync();
        }
        catch (JSException)
        {
            _moduleFailed = true;
            await FailedAsync();
            StateHasChanged();
        }
    }

    private async Task ReadyAsync()
    {
        var wasReady = _ready;
        _ready = true;
        if (!wasReady && Synchronized && Phase == "Narrating") { _lastPhase = null; }
        if (!_moduleFailed) { _failed = false; }
        await ReportReadyAsync();
    }

    private async Task FailedAsync()
    {
        _failed = true;
        _ready = false;
        await ReportReadyAsync();
    }

    private async Task ReloadAsync()
    {
        _failed = false;
        _ready = false;
        _moduleFailed = false;
        await ReportReadyAsync();
        if (_module is not null) { await _module.InvokeVoidAsync("reload", _audio); }
    }

    private async Task ReportReadyAsync()
    {
        var ready = _ready && _module is not null && !_moduleFailed;
        if (ready != _reportedReady)
        {
            _reportedReady = ready;
            await OnReady.InvokeAsync(ready);
        }
    }

    public async Task PlayAsync()
    {
        if (!_ready || _module is null) { throw new JSException("A narração ainda não está pronta."); }
        await _module.InvokeVoidAsync("play", _audio);
    }

    public async Task<bool> UnlockAsync()
    {
        if (_module is null) { throw new JSException("O áudio ainda está sendo preparado."); }
        var ready = await _module.InvokeAsync<bool>("unlock", _audio);
        if (ready) { _ready = true; await ReportReadyAsync(); }
        return ready;
    }
    private async Task ResumeAsync()
    {
        if (_module is not null) { _autoplayBlocked = !await _module.InvokeAsync<bool>("synchronizeShared", _audio, Phase, Offset); }
    }
    private async Task MuteAsync()
    {
        _muted = !_muted;
        if (_module is not null) { await _module.InvokeVoidAsync("mute", _audio, _muted); }
    }
    public async Task StopAsync()
    {
        if (_module is not null) { await _module.InvokeVoidAsync("stop", _audio); }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
