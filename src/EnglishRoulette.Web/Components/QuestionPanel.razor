@using EnglishRoulette.Contracts

@if (State.Question is { } question)
{
    <section class="question-panel" aria-labelledby="question-title">
        <div class="section-label">@(State.Language == "pt-BR" ? "O QUE VOCÊ ENTENDEU?" : "CHECK YOUR UNDERSTANDING")</div>
        <h2 id="question-title" lang="@State.Language" @ref="_heading" tabindex="-1">@question.Prompt</h2>
        <div class="options">
            @foreach (var option in question.Options)
            {
                <button class="option @((State.Answer?.OptionKey ?? AcceptedOptionKey) == option.Key ? "selected" : "")"
                        disabled="@(Busy || AnswerSubmitted || State.Phase != "QuestionOpen")"
                        @onclick="() => OnAnswer.InvokeAsync(option.Key)">
                    <span class="option-letter">@option.Key.ToUpperInvariant()</span><span lang="@State.Language">@option.Text</span>
                </button>
            }
        </div>
        @if (State.Answer is { } answer)
        {
            <div class="question-result-actions">
            <div class="feedback @(answer.IsCorrect ? "correct" : "")" role="status">
                <strong>@(answer.TimedOut ? "O tempo acabou. Tudo bem, vamos aprender." : answer.IsCorrect ? "Isso mesmo! Você entendeu a pista." : "Quase lá. Veja o que a história diz:")</strong>
                <p lang="@State.Language">@answer.Explanation</p>
                @if (!string.IsNullOrWhiteSpace(answer.FullTranslation))
                {
                    <div class="full-translation" lang="pt-BR">
                        <span class="section-label">TRADUÇÃO COMPLETA</span>
                        <p>@answer.FullTranslation</p>
                    </div>
                }
                else if (State.Language == "en")
                {
                    <p class="translation-unavailable">A tradução completa desta cena ainda não foi cadastrada.</p>
                }
                @if (State.Score is { RoundPoints: not null } score)
                { <p class="round-points">@score.RoundBase pontos − @score.RoundDeduction de dicas = <strong>+@score.RoundPoints</strong> · Total: @score.Total</p> }
            </div>
            @if (ShowContinue) { <button class="primary next-button" disabled="@Busy" @onclick="() => OnContinue.InvokeAsync()">
                Continuar a história <span aria-hidden="true">→</span>
            </button> }
            </div>
        }
        else { <p class="hint" role="status">@(AnswerSubmitted ? "Resposta registrada. Aguarde os outros jogadores ou o fim do prazo." : "Escolha uma alternativa. Vale o que você compreendeu.")</p> }
    </section>
}

@code {
    [Parameter, EditorRequired] public AdventureView State { get; set; } = default!;
    [Parameter] public bool FocusOnOpen { get; set; }
    private ElementReference _heading;
    private Guid _focusedInstance;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (FocusOnOpen && State.Phase == "QuestionOpen" && State.Question is { } question && _focusedInstance != question.InstanceId)
        { _focusedInstance = question.InstanceId; await _heading.FocusAsync(); }
    }
    [Parameter] public bool AnswerSubmitted { get; set; }
    [Parameter] public string? AcceptedOptionKey { get; set; }
    [Parameter] public bool ShowContinue { get; set; } = true;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnAnswer { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
}
