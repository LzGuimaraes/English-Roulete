@page "/"
@using EnglishRoulette.Contracts.Admin
@using EnglishRoulette.Contracts
@using EnglishRoulette.Web.Components
@using EnglishRoulette.Web.Services
@implements IAsyncDisposable
@inject AdventureClient Client

<PageTitle>English Roulette — uma história, seu caminho</PageTitle>
<div class="experience motion-@CurrentTheme.Motion" style="@ThemePalette.Style(CurrentTheme)">
<header class="site-header">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">e.</span><span>english<span class="brand-light">roulette</span><small>STORIES THAT TAKE YOU FURTHER</small></span></a>
    <span class="preview-badge"><span></span> Prévia · Solo Adventure</span>
</header>
<main>
    @if (_error is not null)
    {
        <div class="error-banner" role="alert">@_error <button class="text-button" @onclick="RefreshAsync">Tentar reconectar</button></div>
    }
    @if (_loading) { <div class="loading-screen" role="status">Abrindo seu próximo capítulo…</div> }
    else if (_state is null)
    {
        <section class="welcome">
            <div class="welcome-copy">
                <div class="eyebrow"><span class="small-line"></span> APRENDA INGLÊS. VIVA UMA HISTÓRIA.</div>
                <h1>Uma história.<br />Seu próximo<br /><em>caminho.</em></h1>
                <p class="lead">Escolha uma história. Descubra novas palavras.<br class="desktop-break" /> E encontre seu próprio caminho.</p>
                <p class="intro">Ouça e leia em inglês, descubra o que aconteceu e escolha como a história termina. Um capítulo de cada vez.</p>
                @if (_catalog.Count > 0)
                {
                    <label class="catalog-select">Sua próxima história<select @bind="_selectedVersion">@foreach (var story in _catalog) { <option value="@story.Id">@story.Title · @story.Difficulty</option> }</select></label>
                    @if (SelectedStory is { } selected) { <p class="catalog-synopsis">@selected.Synopsis</p><div class="story-meta"><span>@selected.Difficulty · @selected.Genre</span><span>@selected.SceneCount cenas no catálogo</span></div> }
                }
                else { <p class="hint">Novas histórias estão sendo preparadas. Volte em breve.</p> }
                <button class="primary start-button" disabled="@(_busy || _catalog.Count == 0)" @onclick="CreateAsync">@(_busy ? "Preparando…" : "Começar minha aventura") <span aria-hidden="true">↗</span></button>
                <p class="hint">Sem cadastro. Só você e uma boa história.</p><a class="multiplayer-link" href="/multiplayer">Junte o grupo · Multiplayer ↗</a>
            </div>
            <NotebookArt />
        </section>
        <section class="how-it-works" aria-label="Como jogar">
            <div><span class="step-number">01</span><strong>Entre na história</strong><p>Ouça uma cena curta e acompanhe o texto.</p></div>
            <div><span class="step-number">02</span><strong>Siga as pistas</strong><p>Responda com o que você compreendeu.</p></div>
            <div><span class="step-number">03</span><strong>Escolha seu caminho</strong><p>Descubra aonde sua curiosidade leva.</p></div>
        </section>
    }
    else
    {
        <section class="adventure-heading">
            <div><div class="eyebrow">YOUR SOLO ADVENTURE</div><h1>@_state.Title</h1></div>
            <div><button class="text-button" disabled="@_busy" @onclick="CreateAsync">Recomeçar ↻</button><button class="text-button" disabled="@_busy" @onclick="BackToCatalogAsync">Outras histórias</button></div>
        </section>
        <div class="game-grid">
            <article class="story-card">
                <div class="chapter-heading"><span class="section-label">CENA @_state.SceneNumber DO SEU CAMINHO</span><span class="phase-badge">@(_state.Phase == "QuestionOpen" ? $"{RemainingSeconds}s para responder" : PhaseLabel)</span></div>
                <SceneArtwork Visual="_state.Visual" />
                <h2>@_state.SceneTitle</h2>
                @if (_state.Audio is { } audio && _state.Phase != "StoryResult")
                {
                    <NarrationPlayer @key="_state.SceneKey" @ref="_narrator" Audio="audio" Phase="@_state.Phase"
                        ServerNowUtc="_state.ServerNowUtc" PhaseDeadlineUtc="_state.PhaseDeadlineUtc" OnReady="AudioReady" />
                }
                @if (_state.Phase == "Preloading")
                {
                    <div class="scene-ready"><span class="scene-icon" aria-hidden="true">✦</span><h3>Mais uma pista espera por você.</h3><p>Ouça a narração e acompanhe o texto. A pergunta aparece depois do áudio e de uma breve pausa.</p><button class="primary" disabled="@(_busy || !_audioReady)" @onclick="StartAsync">Ouvir e iniciar cena <span aria-hidden="true">→</span></button></div>
                }
                else if (_state.Phase == "StoryResult")
                {
                    <div class="ending"><span class="ending-icon" aria-hidden="true">✦</span><div class="section-label">THE END · OU UM NOVO COMEÇO</div><h2>Você completou<br />esta história.</h2><p>Cada cena trouxe novas palavras e descobertas. Continue explorando outros caminhos.</p><div class="ending-stats"><span>@_state.SceneNumber cenas exploradas</span><span>1 final descoberto</span></div><button class="primary" disabled="@_busy" @onclick="CreateAsync">Jogar novamente ↗</button></div>
                }
                else
                {
                    <p class="narration" lang="en">@_state.Narration</p>
                    @if (_state.Phase == "Narrating") { <div class="reading-note"><span class="pulse-dot"></span><span>Ouça e acompanhe o texto. A pergunta aparece em <strong>@RemainingSeconds s</strong>.</span></div> }
                    <QuestionPanel State="_state" Busy="_busy" OnAnswer="AnswerAsync" OnContinue="ContinueAsync" />
                    @if (_state.Phase == "DecisionOpen")
                    {
                        <section class="decision"><div class="section-label">SUA HISTÓRIA, SUA ESCOLHA</div><h2>Qual será seu próximo caminho?</h2><p>Não existe resposta errada. Siga sua curiosidade.</p>@foreach (var choice in _state.Choices) { <button class="choice" disabled="@_busy" @onclick="() => ChooseAsync(choice.Key)">@choice.Label <span aria-hidden="true">→</span></button> }</section>
                    }
                }
            </article>
            <aside class="journey-card">
                <span class="section-label">SEU CAMINHO ATÉ AQUI</span>
                @foreach (var scene in _state.VisitedScenes ?? [])
                {
                    <div class="journey-stop"><span class="journey-dot active"></span><div><strong>@scene.Title</strong><small>@(scene.Key == _state.SceneKey ? "Você está aqui" : "Cena explorada")</small></div></div>
                }
                @if (_state.Phase == "QuestionOpen") { <div class="timer" role="timer" aria-label="Tempo restante"><strong>@RemainingSeconds<span>s</span></strong><small>para seguir esta pista</small></div> }
                else { <blockquote>“Every new word<br />opens a new door.”</blockquote> }
                <p class="journey-hint">Não precisa entender cada palavra. Procure o sentido da história.</p>
            </aside>
        </div>
    }
</main>
<footer><span>Uma pequena aventura. Um pouco mais de inglês.</span><span>Listening + reading · seu progresso fica salvo · <a href="/admin">Administração</a></span></footer>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private StoryAppearance CurrentTheme => _state?.Appearance ?? SelectedStory?.Appearance ?? new();
    private AdventureView? _state;
    private List<PublicStoryView> _catalog = [];
    private Guid? _selectedVersion;
    private bool _browsing;
    private PublicStoryView? SelectedStory => _catalog.FirstOrDefault(story => story.Id == _selectedVersion);
    private Task? _pollTask;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private long _generation;
    private DateTimeOffset _receivedAtUtc;
    private NarrationPlayer? _narrator;
    private bool _audioReady;

    private int RemainingSeconds => _state?.PhaseDeadlineUtc is { } deadline
        ? Math.Max(0, (int)Math.Ceiling((deadline - _state.ServerNowUtc - (DateTimeOffset.UtcNow - _receivedAtUtc)).TotalSeconds)) : 0;
    private string PhaseLabel => _state?.Phase switch
    {
        "Preloading" => "Uma nova cena", "Narrating" => "Hora da leitura", "QuestionOpen" => "Siga a pista",
        "QuestionReveal" => "Uma descoberta", "DecisionOpen" => "Escolha seu caminho", _ => "História concluída"
    };

    protected override async Task OnInitializedAsync()
    {
        try { _catalog = await Client.CatalogAsync(_lifetime.Token); _selectedVersion = _catalog.FirstOrDefault()?.Id; }
        catch (HttpRequestException) { _error = "Não foi possível carregar as histórias."; }
        await RefreshAsync();
        _loading = false;
        _pollTask = PollAsync();
    }

    private void SetState(AdventureView? state)
    {
        if (_state?.SceneKey != state?.SceneKey || _state?.Phase == "StoryResult") { _audioReady = false; }
        _state = state;
        _receivedAtUtc = DateTimeOffset.UtcNow;
    }

    private async Task RefreshAsync()
    {
        var generation = _generation;
        try
        {
            var state = await Client.GetAsync(_lifetime.Token);
            if (generation == _generation && !_busy && !_browsing) { SetState(state); _error = null; }
        }
        catch (HttpRequestException) { _error = "Não foi possível conectar à aventura. Tente novamente."; }
    }

    private async Task CreateAsync()
    {
        _browsing = false;
        await PerformAsync(() => Client.CreateAsync(_state?.StoryVersionId ?? _selectedVersion, _lifetime.Token));
    }
    private async Task BackToCatalogAsync()
    {
        if (_narrator is not null) { await _narrator.StopAsync(); }
        _browsing = true; _generation++; SetState(null);
        try { _catalog = await Client.CatalogAsync(_lifetime.Token); _selectedVersion = _catalog.FirstOrDefault()?.Id; }
        catch (HttpRequestException) { _error = "Não foi possível carregar as histórias."; }
    }
    private void AudioReady(bool ready) => _audioReady = ready;
    private async Task StartAsync()
    {
        if (_narrator is null) { return; }
        try
        {
            await _narrator.PlayAsync();
            await SendAsync("start");
            if (_state?.Phase != "Narrating") { await _narrator.StopAsync(); }
        }
        catch (JSException) { _error = "Não foi possível reproduzir o áudio. Tente tocar novamente para iniciar."; }
    }
    private async Task AnswerAsync(string option) => await SendAsync("answer", option: option);
    private async Task ContinueAsync() => await SendAsync("continue");
    private async Task ChooseAsync(string choice) => await SendAsync("choose", choice: choice);

    private async Task SendAsync(string kind, string? option = null, string? choice = null)
    {
        if (_state is not { } state) { return; }
        var command = new AdventureCommand(Guid.NewGuid(), state.StateVersion, kind, state.Question?.InstanceId, option, choice);
        await PerformAsync(() => Client.SendAsync(command, _lifetime.Token));
    }

    private async Task PerformAsync(Func<Task<AdventureView?>> action)
    {
        if (_busy) { return; }
        _busy = true;
        _generation++;
        try { SetState(await action()); _error = null; }
        catch (HttpRequestException) { _error = "A conexão foi interrompida. Reconecte para conferir sua aventura."; }
        finally { _busy = false; }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_busy && _state?.Phase is "Narrating" or "QuestionOpen") { await RefreshAsync(); }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_pollTask is not null) { await _pollTask; }
        _lifetime.Dispose();
    }
}
